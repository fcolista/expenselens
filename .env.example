# Container images. Release images are published by GitHub Actions to GHCR, all with the same
# tag, which equals the content of the VERSION file. Pin EXPENSELENS_VERSION in production
# (e.g. 1.0.0) and upgrade with: docker compose pull && docker compose up -d
EXPENSELENS_REGISTRY=ghcr.io/fcolista
EXPENSELENS_VERSION=latest

# Generate values with a password manager. Never commit your real .env file.
POSTGRES_DB=expenselens
POSTGRES_USER=expenselens
# Host port for the optional local database mapping (see docker-compose.yml)
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://expenselens:replace-with-a-long-random-database-password@db:5432/expenselens
SECRET_KEY=replace-this-with-at-least-32-random-characters
ENVIRONMENT=development
SECURE_COOKIES=false
ALLOW_REGISTRATION=true

# Local access via http://localhost:8080. For public hosting, set DOMAIN to a DNS name
# and use Caddy's automatic HTTPS; then set FRONTEND_ORIGIN to https://your-domain.
DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443
FRONTEND_ORIGIN=http://localhost:8080

# Azure F0 receipt OCR or free local Tesseract OCR.
OCR_PROVIDER=tesseract
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
MAX_UPLOAD_BYTES=12582912

# Optional Telegram long-polling worker. Enable with: docker compose --profile telegram up -d
TELEGRAM_BOT_TOKEN=
# Hour (0-23, TZ) for Telegram summaries
TELEGRAM_NOTIFY_HOUR=9
# Passkeys: defaults to the host of FRONTEND_ORIGIN
WEBAUTHN_RP_ID=
# Name shown by the passkey prompt
WEBAUTHN_RP_NAME=ExpenseLens
# Exchange rates: empty = manual, frankfurter = online refresh
RATES_PROVIDER=

# Automatic backups (container "backup": scheduled, rotated, optionally encrypted/uploaded/verified).
# Host user that owns ./backups (run `mkdir -p backups` first); find yours with `id -u` / `id -g`.
BACKUP_UID=1000
BACKUP_GID=1000
TZ=Europe/Rome
BACKUP_ENABLED=true
# Daily time (HH:MM, local TZ) and directory inside the container
BACKUP_TIME=03:30
BACKUP_DIR=/backups
# Rotation (grandfather-father-son); the newest backup is always kept
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# age public key(s) (age1...), comma-separated. Empty = PLAINTEXT backups (a warning is logged).
BACKUP_AGE_RECIPIENT=
# Private key path INSIDE the container, only for full restore verification (see docker-compose.yml)
BACKUP_AGE_IDENTITY_FILE=
# Remote upload: empty | s3 | webdav. Refused without BACKUP_AGE_RECIPIENT unless allowed below.
BACKUP_REMOTE=
BACKUP_ALLOW_UNENCRYPTED_REMOTE=false
# Delete remote backups older than N days (the newest is always kept)
BACKUP_REMOTE_KEEP_DAYS=30
# S3 (AWS, MinIO, Backblaze B2...). Endpoint optional for AWS; provider: AWS, Minio, Other, ...
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=expenselens
BACKUP_S3_PROVIDER=
# WebDAV (vendor: nextcloud | owncloud | other)
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
BACKUP_WEBDAV_VENDOR=
BACKUP_WEBDAV_PATH=expenselens
# Restore verification: weekday (mon..sun), daily, or empty to disable; time HH:MM
BACKUP_VERIFY_DAY=sun
BACKUP_VERIFY_TIME=05:00
# Telegram alerts on failures (uses TELEGRAM_BOT_TOKEN); BACKUP_LANG: it | en
BACKUP_ALERT_TELEGRAM_CHAT_ID=
BACKUP_NOTIFY_SUCCESS=false
BACKUP_LANG=it
